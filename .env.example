# Every setting the agent, the tool server and the eval read. Copy to `.env` and fill in;
# nothing here is a secret that should be committed.

# --- FHIR ------------------------------------------------------------------------
# A public sandbox by default. The tool server holds this token; the agent never sees it.
FHIR_BASE_URL=https://hapi.fhir.org/baseR4
# FHIR_TOKEN=

# --- the tool server (MCP) -------------------------------------------------------
# Where this process listens. Cloud Run overrides the port with its own.
MCP_HOST=127.0.0.1
MCP_PORT=8765
# Where the agent reaches the tool server. Defaults to http://$MCP_HOST:$MCP_PORT/mcp;
# in the deploy this is the other service's URL.
# MCP_SERVER_URL=https://care-task-fhir-xxxx.run.app/mcp
# The tool server's URL, used as the audience for the ID token the agent presents to
# Cloud Run IAM. Set this when the tool server is a private Cloud Run service — the
# deployed path. `just up` sets both of these for you.
# MCP_AUDIENCE=https://care-task-fhir-xxxx.run.app
# A shared secret for the MCP hop, for hosting the tool server where there is no IAM in
# front of it. Alternative to MCP_AUDIENCE, not a layer on top. See docs/API-NOTES.md.
# MCP_AUTH_TOKEN=

# --- the model (Vertex) ----------------------------------------------------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
MODEL_ID=gemini-2.5-flash

# --- the API ---------------------------------------------------------------------
PORT=8080
